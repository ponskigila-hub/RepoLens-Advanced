# Optional OpenAI-compatible LLM insights. Static repository scanning/scoring works without these.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Optional public GitHub API token for higher metadata rate limits.
# Keep this only in the backend environment; never expose it to frontend code.
GITHUB_TOKEN=

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REPOLENS_TEMP_DIR=/tmp/repolens-repos
# Persistent SQLite storage for explicitly shared report snapshots.
REPORT_DB_PATH=./data/reports.sqlite3
PORT=8000
